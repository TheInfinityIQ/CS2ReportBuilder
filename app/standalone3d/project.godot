config_version=5

[application]
config/name="CS2 Standalone Replay"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/use_custom_user_dir=true
config/custom_user_dir_name="CS2StandaloneReplay"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035,0.05,0.075,1)

[shader_globals]
review_modulation_exposure={
"type": "float",
"value": 1.0
}
source_bounce_strength={
"type": "float",
"value": 1.0
}
