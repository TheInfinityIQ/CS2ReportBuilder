extends SceneTree
var failures:Array=[]
func check(value:bool,message:String) -> void:
	if not value:failures.append(message)
func _initialize() -> void:run.call_deferred()
func run() -> void:
	var state=preload("res://presentation_state.gd").new()
	state.configure({"fields":["inspect","clip"],"players":{"7":[[10,0,20],[20,1,20],[21,0,20],[30,1,19],[32,0,null]]}})
	check(not state.at("7",19).has("inspect_tick"),"Inspect occurs before its recorded start")
	check(state.at("7",22).inspect_tick==20,"Clearing pending flag interrupts an authored inspect")
	check(state.at("7",35).inspect_tick==30,"Latest inspect start is lost")
	check(state.at("7",22).inspect_tick==20,"Backward seek retains future inspect")
	check(not state.at("7",35).has("clip"),"Unknown ammunition is fabricated")
	state.configure({"fields":["clip","reserve"],"players":{"7":[[0,20,0]]},"network":{"tickrate":64,"fields":["clip","reserve","anim_state","anim_start_time","network_tick"],"players":{"7":[[100,20,3,"WPN_ANIMSTATE_INSPECT",10.0,650],[120,19,3,"WPN_ANIMSTATE_SHOOT_PRIMARY",10.5,670]]}}})
	check(state.at("7",110).reserve==3,"Reserve uses the wrong network-array element")
	check(state.at("7",110).inspect_tick==90,"Network animation clock does not translate to demo ticks")
	check(state.at("7",125).clip==19,"Weapon state does not follow shot ammunition")
	check(not state.at("7",125).has("inspect_tick"),"Firing resumes an inspect that was cancelled")
	check(not state.at("7",99).has("inspect_tick"),"Future network inspect leaks into backward seek")
	state.configure({"fields":[],"players":{"7":[[0]]},"network":{"tickrate":64,"fields":["weapon","clip","anim_state","anim_start_time","network_tick"],"players":{"7":[[100,"weapon_glock",0,"WPN_ANIMSTATE_RELOAD",10,650],[120,"weapon_glock",20,"WPN_ANIMSTATE_RELOAD",10,670],[150,"weapon_glock",19,"WPN_ANIMSTATE_SHOOT_PRIMARY",11,700],[180,"weapon_usp_silencer",12,"WPN_ANIMSTATE_IDLE",12,730]]}}})
	check(state.at("7",130).action_clip==0,"Empty reload selector changes when magazine refills")
	check(state.at("7",160).action_clip==19,"New action retains prior ammunition snapshot")
	check(state.at("7",130).action_clip==0,"Backward seek changes reload entry input")
	check(state.at("7",190).action_weapon=="weapon_usp_silencer","Weapon change retains Glock inputs")
	var motion=preload("res://source_viewmodel.gd")
	var value:Dictionary={"travel_units":33,"groundspeed":220}
	check(motion.movement_offset(value)==motion.movement_offset(value),"Movement bob depends on frame history")
	check(motion.movement_offset({"travel_units":33,"groundspeed":0})==Vector3.ZERO,"Stationary bob persists")
	check(motion.movement_offset({"travel_units":33,"groundspeed":220,"airborne":true})==Vector3.ZERO,"Grounded bob continues while airborne")
	var radar=preload("res://radar.gd").new();root.add_child(radar)
	radar.configure("de_nuke");check(radar.floor_button.visible,"Nuke floor control missing")
	var upper:Texture2D=radar.texture;radar.set_floor(true)
	check(radar.lower and radar.texture!=upper,"Nuke lower radar does not change")
	radar.configure("de_anubis");check(not radar.lower and not radar.floor_button.visible,"Floor state leaks across maps")
	print(JSON.stringify({"ok":failures.is_empty(),"failures":failures}));quit(0 if failures.is_empty() else 1)
